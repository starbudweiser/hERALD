{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hERALD — fichier de changements (boîte de dépôt)",
  "description": "Fusion prudente : un élément existant (même id, sinon même titre et même jour, ou même nom) n'a que ses champs vides complétés, sauf overwrite: true. Tout ou rien : une erreur et rien n'est appliqué.",
  "type": "object",
  "properties": {
    "format": {
      "const": "herald-changes"
    },
    "overwrite": {
      "type": "boolean",
      "description": "remplacer aussi les champs déjà remplis (tout le fichier)"
    },
    "campaign": {
      "description": "campagne visée (créée si absente) ; par défaut la campagne affichée",
      "oneOf": [
        {
          "type": "string",
          "description": "id (UUID) ou nom/titre exact (casse ignorée)"
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "date": {
              "type": "string",
              "description": "AAAA-MM-JJ (midi), AAAA-MM-JJ HH:MM (heure locale) ou ISO 8601"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "nexus",
              "reddit",
              "discord",
              "youtube",
              "github",
              "x",
              "bluesky",
              "instagram",
              "forum",
              "other"
            ]
          },
          "url": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean"
          }
        }
      }
    },
    "watch": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "URL GitHub ou Nexus, « propriétaire/dépôt », « jeu/identifiant », « reddit: mots-clés » (veille Reddit par treg) ou « youtube: mots-clés » (veille YouTube)"
          },
          "kind": {
            "enum": [
              "github",
              "nexus",
              "reddit",
              "youtube"
            ]
          },
          "ref": {
            "type": "string",
            "description": "propriétaire/dépôt, jeu/identifiant, ou mots-clés recherchés sur Reddit ou YouTube"
          },
          "name": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean"
          }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "title",
          "date"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "AAAA-MM-JJ (midi), AAAA-MM-JJ HH:MM (heure locale) ou ISO 8601"
          },
          "kind": {
            "enum": [
              "teaser",
              "announce",
              "followup",
              "other"
            ]
          },
          "overwrite": {
            "type": "boolean"
          }
        }
      }
    },
    "posts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "description": "AAAA-MM-JJ (midi), AAAA-MM-JJ HH:MM (heure locale) ou ISO 8601"
          },
          "channel": {
            "type": "string",
            "description": "canal : id, nom ou type (reddit, nexus…)"
          },
          "milestone": {
            "type": "string",
            "description": "id (UUID) ou nom/titre exact (casse ignorée)"
          },
          "status": {
            "enum": [
              "idea",
              "draft",
              "approved",
              "published"
            ]
          },
          "link": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "drafts": {
            "type": "object",
            "propertyNames": {
              "enum": [
                "fr",
                "en",
                "es",
                "it"
              ]
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "feedback": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/feedback"
            }
          },
          "overwrite": {
            "type": "boolean"
          }
        },
        "description": "nouvelle publication : title et date obligatoires"
      }
    },
    "feedback": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/feedback"
          },
          {
            "type": "object",
            "required": [
              "post"
            ],
            "properties": {
              "post": {
                "type": "string",
                "description": "id (UUID) ou nom/titre exact (casse ignorée)"
              }
            }
          }
        ]
      }
    },
    "contacts": {
      "type": "array",
      "description": "Contacts de démarchage (youtubeurs, presse…) de la campagne. Fusion par nom ou id ; « overwrite » comme pour les publications.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "youtuber",
              "press",
              "site",
              "discord",
              "forum",
              "other"
            ]
          },
          "url": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "lang": {
            "enum": [
              "fr",
              "en",
              "es",
              "it"
            ]
          },
          "status": {
            "enum": [
              "toContact",
              "contacted",
              "followedUp",
              "replied",
              "accepted",
              "declined",
              "covered"
            ]
          },
          "nextFollowUp": {
            "type": "string"
          },
          "coverage": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "overwrite": {
            "type": "boolean"
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "date"
              ],
              "properties": {
                "date": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "first",
                    "followUp",
                    "reply",
                    "note"
                  ]
                },
                "direction": {
                  "enum": [
                    "draft",
                    "sent",
                    "received"
                  ]
                },
                "subject": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "mailID": {
                  "type": "string",
                  "description": "identifiant du message dans l'app Mail (message id) : la relève des réponses ne le réimporte pas"
                }
              }
            }
          }
        },
        "required": [
          "name"
        ]
      }
    }
  },
  "$defs": {
    "feedback": {
      "type": "object",
      "required": [
        "date"
      ],
      "properties": {
        "date": {
          "type": "string",
          "description": "AAAA-MM-JJ (midi), AAAA-MM-JJ HH:MM (heure locale) ou ISO 8601"
        },
        "kind": {
          "enum": [
            "comment",
            "downloads",
            "endorsements",
            "stars",
            "views",
            "other"
          ]
        },
        "value": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        }
      }
    }
  }
}
